#!/bin/sh
# Chime session. Display managers start Xorg or a Wayland seat, then exec
# this; when the WM/compositor exits, the session ends. Helpers live in
# LIBEXEC so `editor` does not shadow the system editor outside this session.
LIBEXEC=@LIBEXECDIR@
DATA=@DATADIR@
export PATH="$LIBEXEC:${PATH:-/usr/bin}"
export CHIME_DATA_DIR="$DATA"
export XDG_CURRENT_DESKTOP=Chime
export XDG_SESSION_DESKTOP=chime
# PREFIX/share (parent of DATADIR) so Cabinet/Editor/Terminal .desktop files
# are visible even when PREFIX is not already on XDG_DATA_DIRS.
SHARE=$(dirname "$DATA")
export XDG_DATA_DIRS="$SHARE:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

WAYLAND=0
for arg in "$@"; do
    case "$arg" in
        --wayland) WAYLAND=1 ;;
    esac
done
if [ "$WAYLAND" = 1 ] || [ "${CHIME_BACKEND:-}" = wayland ] || [ "${XDG_SESSION_TYPE:-}" = wayland ]; then
    export CHIME_BACKEND=wayland
    export XDG_SESSION_TYPE=wayland
    # Full seat compositor: do not nest under a leftover greeter display.
    unset WAYLAND_DISPLAY
    unset DISPLAY
    if [ -n "${HOME:-}" ]; then
        mkdir -p "$HOME/.chime" 2>/dev/null || true
        if [ -d "$HOME/.chime" ]; then
            exec >>"$HOME/.chime/wayland-session.log" 2>&1
        fi
    fi
    echo "---- $(date -Iseconds 2>/dev/null || date) pid=$$ ----"
    if ! ldd "$LIBEXEC/chime" 2>/dev/null | grep -q wlroots; then
        echo "chime: $LIBEXEC/chime is not linked to wlroots (rebuild with: make CHIME_WL=1)" >&2
        exit 1
    fi
    if [ -d /sys/module/nvidia_drm ]; then
        export WLR_NO_HARDWARE_CURSORS="${WLR_NO_HARDWARE_CURSORS:-1}"
        export GBM_BACKEND="${GBM_BACKEND:-nvidia-drm}"
        export __GLX_VENDOR_LIBRARY_NAME="${__GLX_VENDOR_LIBRARY_NAME:-nvidia}"
    fi
    export XKB_DEFAULT_LAYOUT="${XKB_DEFAULT_LAYOUT:-us}"
fi

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- "$LIBEXEC/chime"
fi
exec "$LIBEXEC/chime"
