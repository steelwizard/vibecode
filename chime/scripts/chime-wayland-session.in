#!/bin/sh
# Wayland login session for the Chime tree at @ROOT@. Display managers exec
# this instead of nesting under the greeter.
ROOT=@ROOT@
export PATH="$ROOT:${PATH:-/usr/bin}"
export CHIME_DATA_DIR="$ROOT"
export CHIME_BACKEND=wayland
export XDG_CURRENT_DESKTOP=Chime
export XDG_SESSION_DESKTOP=chime
export XDG_SESSION_TYPE=wayland
export XDG_DATA_DIRS="$ROOT/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
# Full seat compositor: do not nest under a leftover greeter display.
unset WAYLAND_DISPLAY
unset DISPLAY

if [ -n "${HOME:-}" ]; then
    mkdir -p "$HOME/.chime" 2>/dev/null || true
    if [ -d "$HOME/.chime" ]; then
        exec >>"$HOME/.chime/wayland-session.log" 2>&1
    fi
fi
echo "---- $(date -Iseconds 2>/dev/null || date) pid=$$ ----"

cd "$ROOT" || exit 1
if [ ! -x "$ROOT/chime" ]; then
    echo "chime: missing $ROOT/chime (run make in that tree)" >&2
    exit 1
fi
if ! ldd "$ROOT/chime" 2>/dev/null | grep -q wlroots; then
    echo "chime: $ROOT/chime is not linked to wlroots (rebuild with: make CHIME_WL=1)" >&2
    exit 1
fi
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    echo "chime: XDG_RUNTIME_DIR is unset" >&2
    exit 1
fi
if [ -d /sys/module/nvidia_drm ]; then
    export WLR_NO_HARDWARE_CURSORS="${WLR_NO_HARDWARE_CURSORS:-1}"
    export GBM_BACKEND="${GBM_BACKEND:-nvidia-drm}"
    export __GLX_VENDOR_LIBRARY_NAME="${__GLX_VENDOR_LIBRARY_NAME:-nvidia}"
fi
export XKB_DEFAULT_LAYOUT="${XKB_DEFAULT_LAYOUT:-us}"

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- "$ROOT/chime"
fi
exec "$ROOT/chime"
